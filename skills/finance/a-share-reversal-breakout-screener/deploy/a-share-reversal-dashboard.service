[Unit]
Description=A-share reversal breakout interactive dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.hermes/skills/finance/a-share-reversal-breakout-screener
ExecStart=/usr/bin/python3 /root/.hermes/skills/finance/a-share-reversal-breakout-screener/scripts/server.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
